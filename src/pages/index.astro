---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Band from '../components/Band.astro';
import Discover from '../components/Discover.astro';
import Specs from '../components/Specs.astro';
import Contact from '../components/Contact.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Logistics Software | Logistics ERP | ERP Logistics | CargoDash"
  description="CargoDash is a one stop solution for your Logistics ERP requirements. Cloud based SaaS product for Air and Ocean freight forwarders, with HRM, Tally integration and credit control."
>
  <Header />
  <Hero />
  <Band text="Cargo Dash is a one stop solution for your Logistics ERP requirements." />
  <Discover />
  <Band text="Powerful modules to manage the entire workflow efficiently." />
  <Specs />
  <Band text="Designed by the experts, accepted by the industry." />
  <Contact />
  <Features />
  <Footer />
</Base>
