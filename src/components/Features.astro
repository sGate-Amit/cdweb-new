---
import { features } from '../data/site';
---
<section class="features">
  <div class="shell">
    <h2 class="section-title">Features</h2>
    <div class="feature-row">
      {features.map((ft) => (
        <div class="feature">
          <!--<span>{ft.label}</span>-->
          <img src={ft.icon} alt="" />
        </div>
      ))}
    </div>
  </div>
</section>
