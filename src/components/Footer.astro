---
import Logo from './Logo.astro';
import { footerSpecs, contact } from '../data/site';
const socials = [
  { label: 'LinkedIn', href: '#', glyph: 'in' },
  { label: 'Facebook', href: '#', glyph: 'f' },
  { label: 'Twitter', href: '#', glyph: 'x' },
  { label: 'YouTube', href: '#', glyph: '\u25B6' },
];
---
<footer class="site-footer">
  <div class="shell">
    <div>
      <h4>About CargoDash</h4>
      <p>
        Cargo Dash is a one stop solution for your Logistics ERP requirements. Designed by the experts,
        accepted by the industry. Powerful modules to manage the entire workflow efficiently.
      </p>
    </div>
    <div>
      <h4>Specs</h4>
      <ul>{footerSpecs.map((s) => <li>{s}</li>)}</ul>
    </div>
    <div>
      <h4>Quick Contact Info</h4>
      <p>{contact.company}</p>
      <p>{contact.address.map((line) => <Fragment>{line}<br /></Fragment>)}</p>
      <p><a href={'mailto:' + contact.email}>{contact.email}</a></p>
      <p>{contact.phones}</p>
    </div>
    <div>
      <h4>Locations:</h4>
      <iframe class="map" src={contact.mapEmbed} title="sGate Tech Solutions office location" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</footer>
<div class="footer-bar">
  <div class="shell">
   <a href="/" class="brand" aria-label="CargoDash home">
<img src="/images/footer-logo.png" alt="CargoDash logistics ERP shown on a laptop" />
</a>
    <div class="legal">
      <div>Copyrights 2026 &copy; CargoDash.</div>
      <div><a href="/privacy-policy">Privacy Policy</a> | <a href="/terms">Terms and Conditions</a></div>
      <div>Powered by sGate Tech Solutions Pvt. Ltd.</div>
    </div>
    <div class="socials">
      {socials.map((s) => <a href={s.href} aria-label={s.label}>{s.glyph}</a>)}
    </div>
  </div>
</div>
