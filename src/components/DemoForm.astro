---
interface Props { variant?: 'hero' | 'contact'; heading?: string; target?: 'heart' | 'truck'; }
const { variant = 'hero', heading = 'Book a Demo', target = 'heart' } = Astro.props;
const id = variant;
const glyphs = [
  { key: 'heart', label: 'Heart', path: 'M12 21s-7.5-4.7-9.3-9A5.2 5.2 0 0 1 12 6.6 5.2 5.2 0 0 1 21.3 12c-1.8 4.3-9.3 9-9.3 9Z' },
  { key: 'truck', label: 'Truck', path: 'M2 7h11v9H2zM13 10h4l4 3v3h-8zM6 19a1.7 1.7 0 1 0 0-3.4A1.7 1.7 0 0 0 6 19Zm11 0a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4Z' },
  { key: 'home', label: 'Home', path: 'M3 11 12 4l9 7v9h-6v-6H9v6H3z' },
];
---
<form class="demo-form" data-form={id} data-target={target} novalidate>
  <input type="text" name="name" placeholder="Name" autocomplete="name" required />
  <input type="email" name="email" placeholder="Email" autocomplete="email" required />
  <input type="tel" name="mobile" placeholder="Mobile" autocomplete="tel" required />
  <input type="text" name="organization" placeholder="Organization" autocomplete="organization" required />
  <input type="text" name="teamSize" placeholder="Team Size" required />
  <input type="hidden" name="challenge" value={target} />
  <input type="hidden" name="answer" value="" />
  <div class="human-check">
    <p>Please prove you are human by selecting the <strong>{target}</strong>.</p>
    <div class="choices" role="group" aria-label={'Select the ' + target}>
      {glyphs.map((g) => (
        <button type="button" data-answer={g.key} aria-pressed="false" aria-label={g.label}>
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d={g.path} /></svg>
        </button>
      ))}
    </div>
  </div>
  <button class="btn btn-navy" type="submit">Submit</button>
  <p class="form-note" data-note aria-live="polite"></p>
</form>
