---
import { getDemoCaptcha } from '../lib/captcha';

interface Props { variant?: 'hero' | 'contact'; heading?: string; }
const { variant = 'hero', heading = 'Book a Demo' } = Astro.props;
const id = variant;
const captcha = await getDemoCaptcha();
---
<form class="demo-form" data-form={id} novalidate>
  <input type="text" name="name" placeholder="Name" autocomplete="name" required />
  <input type="email" name="email" placeholder="Email" autocomplete="email" required />
  <input type="tel" name="mobile" placeholder="Mobile" autocomplete="tel" required />
  <input type="text" name="organization" placeholder="Organization" autocomplete="organization" required />
  <input type="text" name="teamSize" placeholder="Team Size" required />
  <input type="hidden" name="kc_captcha" value="" />
  <div class="human-check">
    {captcha ? (
      <>
        <p>Please prove you are human by selecting the <strong>{captcha.word}</strong>.</p>
        <div class="choices" role="group" aria-label={'Select the ' + captcha.word}>
          {captcha.options.map((opt, i) => (
            <button type="button" data-answer={opt.value} aria-pressed="false" aria-label={'Option ' + (i + 1)}>
              <svg viewBox={opt.viewBox} width="26" height="26" fill="currentColor" aria-hidden="true"><path d={opt.path} /></svg>
            </button>
          ))}
        </div>
      </>
    ) : (
      <p>Verification is temporarily unavailable — please refresh the page or email mailus@sgate.in.</p>
    )}
  </div>
  <button class="btn btn-navy" type="submit" disabled={!captcha}>Submit</button>
  <p class="form-note" data-note aria-live="polite"></p>
</form>
