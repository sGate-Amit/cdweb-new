---
interface Props { variant?: 'hero' | 'contact'; heading?: string; }
const { variant = 'hero', heading = 'Book a Demo' } = Astro.props;
const id = variant;
---
<form class="demo-form" data-form={id} novalidate>
  <input type="text" name="name" placeholder="Name" autocomplete="name" required />
  <input type="email" name="email" placeholder="Email" autocomplete="email" required />
  <input type="tel" name="mobile" placeholder="Mobile" autocomplete="tel" required />
  <input type="text" name="organization" placeholder="Organization" autocomplete="organization" required />
  <input type="text" name="teamSize" placeholder="Team Size" required />
  <button class="btn btn-navy" type="submit">Submit</button>
  <p class="form-note" data-note aria-live="polite"></p>
</form>
