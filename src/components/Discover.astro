---
import { discover } from '../data/site';
const top = discover.slice(0, 3);
const bottom = discover.slice(3);
---
<section class="section" id="discover">
  <div class="shell">
    <h2 class="section-title">Discover</h2>
    <div class="card-grid">
      {top.map((c) => (
        <article class="card">
          <div class="card-icon"><img src={c.icon} alt="" width="128" height="128" /></div>
          <h3>{c.title}</h3>
          <ul>{c.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="card-grid row-2">
      {bottom.map((c) => (
        <article class="card">
          <div class="card-icon"><img src={c.icon} alt="" width="128" height="128" /></div>
          <h3>{c.title}</h3>
          <ul>{c.points.map((p) => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>
